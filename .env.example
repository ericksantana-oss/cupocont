# Postgres (com extensão pgvector habilitada)
DATABASE_URL="postgresql://cupocont:cupocont@localhost:5432/cupocont?schema=public"

# Autenticação — usado para assinar o cookie de sessão
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# IA generativa (temas e textos finais)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"

# Embeddings do RAG: modelo local (all-MiniLM-L6-v2 via @xenova/transformers),
# sem API externa nem custo por chamada — nenhuma variável necessária aqui.

# Palavras-chave: enquanto não plugamos uma API real, fica em "mock"
KEYWORDS_PROVIDER="mock"

# Armazenamento de arquivos (documentos de contexto dos clientes)
# Nomes prefixados com APP_ de propósito, para não colidir com o namespace
# reservado pela integração automática Supabase<->Vercel.
APP_SUPABASE_URL=""
APP_SUPABASE_SERVICE_ROLE_KEY=""

# Meta Graph API (conexão com Instagram das contas dos clientes)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://seu-dominio.vercel.app/api/meta/callback"

# Segredo pra proteger a rota de cron que publica posts agendados automaticamente
CRON_SECRET=""
