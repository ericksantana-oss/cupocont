generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  ADMIN
  WRITER
  INTERN // acesso de leitura/escrita a todos os squads, mas sem o painel de administração
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum ThemeStatus {
  SUGGESTED
  SELECTED
  DISCARDED
}

enum TextStatus {
  DRAFT
  APPROVED
}

// Veredito do CLIENTE sobre um post, coletado depois da aprovação interna.
// Dois estados de propósito: "aprovado com ajuste" caberia no comentário, e um terceiro
// estado exigiria decidir se ele agenda ou não — nuance sem regra clara vira confusão.
enum ClientVerdict {
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(WRITER)
  squadId      String? // squad "casa" do redator; acesso extra fora do squad passa por ClientAccess
  createdAt    DateTime @default(now())

  squad           Squad?           @relation(fields: [squadId], references: [id], onDelete: SetNull)
  clientAccess    ClientAccess[]
  ownedClients    Client[]         @relation("ClientOwner")
  briefings       Briefing[]       @relation("BriefingCreator")
  texts           GeneratedText[]  @relation("TextEditor")
  sessions        Session[]
  activityLogs    ActivityLog[]
  marketingEmails MarketingEmail[] @relation("EmailCreator")
  scheduledPosts  ScheduledPost[]  @relation("PostScheduler")
  clientRules     ClientRule[]     @relation("RuleAuthor")
  openedDemands   ContentDemand[]  @relation("DemandCreator")
  closedDemands   ContentDemand[]  @relation("DemandCloser")
  postSchedules   PostSchedule[]   @relation("ScheduleRegistrar")
  clientFeedbacks ClientFeedback[] @relation("FeedbackRegistrar")

  @@map("users")
}

// sessão de login: cookie httpOnly guarda apenas o id/token, tudo mais fica no banco
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Time/squad da agência — agrupa redatores e clientes. Um redator vê por padrão
// só os clientes do próprio squad; acesso a clientes de outro squad passa por
// ClientAccess (liberação pontual), sem precisar mudar de squad.
model Squad {
  id        String   @id @default(cuid())
  name      String
  logoPath  String? // caminho no bucket público squad-logos
  createdAt DateTime @default(now())

  members User[]
  clients Client[]

  @@map("squads")
}

// redator <-> cliente é N:N (um redator pode atender vários clientes)
model ClientAccess {
  id       String @id @default(cuid())
  userId   String
  clientId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("client_access")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  // Sigla curta usada nos títulos de demanda e de post ("ETM"). Única, porque é o que
  // identifica o cliente na ferramenta de gestão — duas iguais deixariam duas demandas
  // indistinguíveis. Nula só nos clientes cadastrados antes deste campo existir.
  acronym   String?  @unique
  niche     String // nicho/segmento, usado na busca de palavras-chave
  ownerId   String? // redator principal responsável pelo cliente, para o painel admin
  squadId   String? // squad dono do cliente — define quem tem acesso automático
  createdAt DateTime @default(now())

  owner            User?             @relation("ClientOwner", fields: [ownerId], references: [id])
  squad            Squad?            @relation(fields: [squadId], references: [id], onDelete: SetNull)
  access           ClientAccess[]
  documents        ClientDocument[]
  briefings        Briefing[]
  keywordReports   KeywordReport[]
  themes           ContentTheme[]
  activityLogs     ActivityLog[]
  emailFlows       EmailFlow[]
  marketingEmails  MarketingEmail[]
  instagramAccount InstagramAccount?
  scheduledPosts   ScheduledPost[]
  storyInsights    StoryInsight[]
  metricSnapshots  MetricSnapshot[]
  rules            ClientRule[]
  demands          ContentDemand[]
  postSchedules    PostSchedule[]
  clientFeedbacks  ClientFeedback[]

  @@map("clients")
}

// Correções que o redator quis tornar permanentes. Nascem das "instruções extras"
// de uma regeneração: sem isto a correção morre naquela geração e a IA repete o
// mesmo erro no mês seguinte, obrigando alguém a corrigir de novo.
model ClientRule {
  id          String   @id @default(cuid())
  clientId    String
  rule        String
  createdById String
  createdAt   DateTime @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation("RuleAuthor", fields: [createdById], references: [id])

  @@index([clientId])
  @@map("client_rules")
}

// Retrato mensal das métricas de cada cliente, gravado pelo cron. O dashboard
// consulta o Meta ao vivo e não guarda nada, então sem isto não existe histórico:
// analisar tendência de vários meses seria impossível para sempre, porque o dado
// não estaria sendo acumulado. Mesmo raciocínio da captura de Stories.
model MetricSnapshot {
  id       String @id @default(cuid())
  clientId String
  period   String // "2026-08"

  // Instagram
  followers       Int?
  mediaCount      Int?
  reach           Int? // soma do alcance de cada dia — é o número que o Reportei mostra
  reachUnique     Int? // alcance deduplicado no período
  views           Int?
  profileViews    Int?
  accountsEngaged Int?
  interactions    Int?
  websiteClicks   Int?
  dailyReach      Json? // [{ date, value }] para o gráfico
  posts           Json? // tabela de postagens congelada

  // Facebook
  fbFollowers    Int?
  fbPageViews    Int?
  fbEngagement   Int?
  fbNewFollowers Int?
  fbPosts        Json?

  // true quando o mês fechou e foi capturado por inteiro. Mês corrente fica false
  // e é reescrito a cada execução; mês fechado não se mexe mais.
  closed     Boolean  @default(false)
  capturedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, period])
  @@index([clientId, period])
  @@map("metric_snapshots")
}

// Instantâneo dos Stories ativos capturado pelo cron diário — a API do Meta só expõe
// Stories das últimas 24h, então esse é o único jeito de acumular histórico pro dashboard.
model StoryInsight {
  id            String   @id @default(cuid())
  clientId      String
  mediaId       String   @unique
  timestamp     DateTime // quando o story foi publicado
  impressions   Int?
  reach         Int?
  interactions  Int?
  replies       Int?
  shares        Int?
  tapsForward   Int?
  tapsBack      Int?
  exits         Int?
  profileVisits Int?
  capturedAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, timestamp])
  @@map("story_insights")
}

// Guarda temporariamente as páginas/contas do Instagram encontradas após o
// login no Facebook, quando há mais de uma opção e o usuário precisa escolher
// qual pertence a este cliente. Registro de curta duração, apagado após a escolha.
model InstagramPendingSelection {
  id         String   @id @default(cuid())
  clientId   String
  candidates Json // [{ pageName, igUserId, igUsername, pageAccessToken }]
  createdAt  DateTime @default(now())

  @@map("instagram_pending_selections")
}

// Conexão do cliente com a conta comercial do Instagram, via Meta Graph API.
model InstagramAccount {
  id              String    @id @default(cuid())
  clientId        String    @unique
  igUserId        String // id da conta comercial do Instagram
  igUsername      String?
  pageId          String? // id da Página do Facebook vinculada, usada para publicar no Facebook também
  pageName        String?
  pageAccessToken String // token da página do Facebook vinculada, não expira enquanto a conexão for válida
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?
  summary         String? // resumo em texto dos posts/metricas mais recentes, usado como contexto para a IA

  // Saúde da conexão, conferida pelo cron diário via /debug_token.
  // O token de Página em si não expira (o debug_token devolve expires_at = 0), mas o
  // ACESSO AOS DADOS vence 90 dias depois da autorização. Quando vence, as consultas
  // passam a falhar em silêncio e o cron para de congelar os meses — e mês não
  // congelado não volta, porque o Meta descarta insights antigos.
  tokenValid               Boolean   @default(true)
  tokenCheckedAt           DateTime? // última vez que o debug_token foi consultado
  tokenExpiresAt           DateTime? // nulo no caso normal: token de Página não expira
  tokenDataAccessExpiresAt DateTime? // o prazo que realmente corre
  tokenError               String? // mensagem do Meta quando o token deixa de valer

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("instagram_accounts")
}

model ClientDocument {
  id           String         @id @default(cuid())
  clientId     String
  fileName     String
  fileType     String // pdf | docx | txt | link
  originalPath String? // caminho no disco (MVP)
  sourceUrl    String? // se for um link de referência
  status       DocumentStatus @default(PROCESSING)
  errorMessage String?
  createdAt    DateTime       @default(now())

  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@map("client_documents")
}

// cada chunk de texto vira uma linha com seu embedding (pgvector)
model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  clientId   String // duplicado do documento pai para filtrar direto sem join no retrieve
  content    String
  embedding  Unsupported("vector(384)")? // dimensão do modelo local all-MiniLM-L6-v2
  chunkIndex Int
  createdAt  DateTime                    @default(now())

  document ClientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("document_chunks")
}

model KeywordReport {
  id        String   @id @default(cuid())
  clientId  String
  period    String // "2026-08"
  keywords  Json // [{ term, volume, trend }]
  source    String   @default("mock") // mock | google_trends | semrush | ...
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("keyword_reports")
}

model Briefing {
  id              String   @id @default(cuid())
  clientId        String
  period          String // "2026-08"
  goals           String // o briefing inteiro, em texto livre
  keyDates        String? // datas comemorativas do período
  suggestedThemes String? // temas que o próprio redator quer ver na lista
  createdById     String
  createdAt       DateTime @default(now())

  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User           @relation("BriefingCreator", fields: [createdById], references: [id])
  themes    ContentTheme[]

  @@unique([clientId, period])
  @@map("briefings")
}

model ContentTheme {
  id            String                      @id @default(cuid())
  clientId      String
  briefingId    String
  title         String
  justification String // por que a IA sugeriu esse tema
  status        ThemeStatus                 @default(SUGGESTED)
  createdAt     DateTime                    @default(now())
  // Vetor do título + justificativa, usado para detectar tema repetido em meses
  // anteriores do mesmo cliente. Mesmo modelo local dos documentos (384 dimensões).
  embedding     Unsupported("vector(384)")?
  // Número do post dentro da demanda ("Post 1"). Congelado quando a produção é
  // finalizada e nunca recalculado: é o nome que a pessoa escreveu no Meta, e se
  // mudasse de lugar depois o agendamento registrado deixaria de bater.
  postIndex     Int?

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  briefing       Briefing        @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  texts          GeneratedText[]
  postSchedule   PostSchedule?
  clientFeedback ClientFeedback?

  @@map("content_themes")
}

model GeneratedText {
  id          String       @id @default(cuid())
  themeId     String
  version     Int          @default(1)
  content     String
  status      TextStatus   @default(DRAFT)
  editedById  String
  createdAt   DateTime     @default(now())
  mediaFormat MediaFormat?
  mediaPaths  Json? // caminhos no bucket post-media, na ordem de exibição (carrossel)
  pieceFormat PieceFormat? // escolhido pelo redator antes de gerar
  imageText   String? // texto que vai na arte do card único (máx 150)
  slides      Json? // carrossel: [{ role: "CAPA"|"INTERNO"|"CTA", text }] na ordem de exibição

  theme          ContentTheme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  editedBy       User            @relation("TextEditor", fields: [editedById], references: [id])
  scheduledPosts ScheduledPost[]

  @@map("generated_texts")
}

// Formato editorial da peça: card único ou carrossel. Define quais campos de texto
// a IA preenche e quais limites de caracteres valem na revisão.
enum PieceFormat {
  CARD
  CARROSSEL
}

enum MediaFormat {
  IMAGE
  CAROUSEL
  REELS
  VIDEO
  STORIES
}

enum ActivityAction {
  CONTEXT_UPDATED
  KEYWORDS_RESEARCHED
  BRIEFING_SAVED
  THEMES_GENERATED
  THEME_SELECTED
  THEME_DISCARDED
  TEXT_GENERATED
  TEXT_EDITED
  TEXT_APPROVED
  POST_PUBLISHED
  DEMAND_OPENED
  PRODUCTION_CLOSED
  POST_SCHEDULED
  CLIENT_FEEDBACK
}

// Trilha de ações usada pelo painel admin: "o que aconteceu, quem fez, quando".
model ActivityLog {
  id        String         @id @default(cuid())
  clientId  String
  userId    String
  action    ActivityAction
  detail    String? // texto curto legível, ex: título do tema ou do documento
  period    String? // "2026-08" quando a ação é ligada a um mês específico
  createdAt DateTime       @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

enum MarketingEmailType {
  PONTUAL
  FLUXO
}

enum EmailStatus {
  DRAFT
  REVIEW
  APPROVED
}

// Agrupa e-mails de um mesmo fluxo (nutrição, lançamento, etc.) só para
// organização/histórico — o planejamento do fluxo em si é feito fora da ferramenta.
model EmailFlow {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  createdAt DateTime @default(now())

  client Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  emails MarketingEmail[]

  @@map("email_flows")
}

model MarketingEmail {
  id       String             @id @default(cuid())
  clientId String
  flowId   String?
  type     MarketingEmailType
  name     String // nome do e-mail ou da etapa do fluxo
  briefing String // contexto/mini-briefing livre fornecido pelo redator
  status   EmailStatus        @default(DRAFT)

  // gerado pela IA, editável e regenerável em blocos
  subjectA  String?
  subjectB  String?
  preheader String?
  hasCard   Boolean @default(false)
  cardText  String?
  body      String?
  ctaText   String?
  farewell  String?

  // preenchimento manual do redator, a IA não inventa esses dados
  audience        String? // base que será impactada
  senderName      String?
  senderEmail     String?
  ctaColor        String?
  imagesFolderUrl String? // link do drive com imagens

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  flow      EmailFlow? @relation(fields: [flowId], references: [id], onDelete: SetNull)
  createdBy User       @relation("EmailCreator", fields: [createdById], references: [id])

  @@map("marketing_emails")
}

enum PublishChannel {
  INSTAGRAM
  FACEBOOK
}

enum PublishStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  ERROR
}

// Registro de cada tentativa de publicação (imediata ou agendada) num canal.
// Um mesmo texto aprovado pode gerar um registro por canal escolhido.
model ScheduledPost {
  id           String         @id @default(cuid())
  clientId     String
  textId       String? // presente quando criado a partir de um texto aprovado; nulo nos posts avulsos da tela "Agendar post"
  channel      PublishChannel
  format       MediaFormat
  caption      String
  mediaPaths   Json
  scheduledAt  DateTime // quando deve/deveria publicar; "agora" = momento da criação
  status       PublishStatus  @default(SCHEDULED)
  publishedAt  DateTime?
  permalink    String?
  errorMessage String? // mensagem traduzida, exibida ao usuário
  errorRaw     String? // erro técnico original, só pra consulta administrativa
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text      GeneratedText? @relation(fields: [textId], references: [id], onDelete: SetNull)
  createdBy User           @relation("PostScheduler", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([status, scheduledAt])
  @@map("scheduled_posts")
}

// A "demanda" do mês: o mês de conteúdo como registro próprio.
//
// Antes disto o mês só existia indiretamente, através do Briefing — ou seja, nascia
// quando o briefing era salvo. O nº da tarefa é pedido ao ABRIR o mês, antes de existir
// briefing, então o mês precisou de um registro próprio.
//
// O título exibido é derivado, não guardado: "ETM | 92857 | Redes Sociais Setembro".
// Guardar o texto montado deixaria títulos velhos para trás quando a sigla mudasse.
model ContentDemand {
  id         String @id @default(cuid())
  clientId   String
  period     String // "2026-09"
  taskNumber String // nº da tarefa na ferramenta de gestão, ex "92857"

  // Marco de "produção finalizada": é aqui que a numeração dos posts congela e a
  // demanda passa a aparecer na tela de agendamento.
  productionClosedAt DateTime?
  closedById         String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User             @relation("DemandCreator", fields: [createdById], references: [id])
  closedBy  User?            @relation("DemandCloser", fields: [closedById], references: [id])
  schedules PostSchedule[]
  feedbacks ClientFeedback[]

  @@unique([clientId, period])
  @@map("content_demands")
}

// Registro MANUAL de que o post foi agendado no Business Suite.
//
// Não confundir com ScheduledPost: aquele é a fila de publicação pela ferramenta, que
// está fora de escopo. Este não publica nada e não fala com o Meta — é o redator
// anotando o que já agendou por fora. É justamente por ser manual que funciona: o Meta
// não expõe a fila de agendamento do Business Suite por API (ver docs/aprendizados.txt).
model PostSchedule {
  id       String @id @default(cuid())
  clientId String
  demandId String
  themeId  String @unique // um dia por post: arrastar move o registro, não duplica

  scheduledFor DateTime // o dia em que o post foi agendado no Meta

  registeredById String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  demand       ContentDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  theme        ContentTheme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  registeredBy User          @relation("ScheduleRegistrar", fields: [registeredById], references: [id])

  @@index([clientId, scheduledFor])
  @@index([scheduledFor])
  @@map("post_schedules")
}

// Feedback do CLIENTE sobre cada post, coletado entre finalizar a produção e agendar.
//
// Serve a dois propósitos ao mesmo tempo, e é por isso que vale uma tabela em vez de um
// campo solto: (1) post reprovado pelo cliente não vai para o agendamento; (2) o que o
// cliente recusou e comentou entra nos prompts das entregas seguintes.
//
// Sobre o (2): não é aprendizado de máquina. Não há treino nem memória do modelo. O
// texto do feedback é lido do banco e injetado no prompt a cada geração, pelo mesmo
// caminho das regras fixas (buildClientKnowledgeContext).
model ClientFeedback {
  id       String        @id @default(cuid())
  clientId String
  demandId String
  themeId  String        @unique // um veredito por post
  verdict  ClientVerdict
  comment  String? // o que o cliente falou daquele post; é o que tem valor para a IA

  registeredById String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  demand       ContentDemand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  theme        ContentTheme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  registeredBy User          @relation("FeedbackRegistrar", fields: [registeredById], references: [id])

  @@index([clientId, createdAt])
  @@map("client_feedbacks")
}

// Notícias do mercado imobiliário (feed RSS externo), exibidas na tela inicial pra todo mundo.
model MarketNews {
  id        String   @id @default(cuid())
  guid      String   @unique
  title     String
  link      String
  source    String
  pubDate   DateTime
  fetchedAt DateTime @default(now())

  @@index([pubDate])
  @@map("market_news")
}
